[Unit]
Description=备婚 Agent 助手（飞书长连接机器人）
After=network-online.target
Wants=network-online.target

# ⚠️ 这两行必须在 [Unit] 段。写在 [Service] 里 systemd 会直接忽略
#    （日志里只有一行 "Unknown key name ... ignoring."，服务照常启动，
#    所以很容易漏掉），然后默认的启动频率限制继续生效：10 秒内启动超过
#    5 次就**放弃重启**。那意味着崩溃循环时 Restart=always 形同虚设，
#    机器人会彻底躺平 —— 而它躺平是静默的，飞书那边只表现为「发消息没反应」。
StartLimitIntervalSec=0
StartLimitBurst=0

[Service]
Type=simple
WorkingDirectory=/srv/wedding
EnvironmentFile=/srv/wedding/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node bot/index.mjs

# 长连接断了要能自己回来
Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=wedding-bot

# ── 加固（可选项）────────────────────────────────────────────────
# 如果服务起不来（常见于 Claude 需要写 HOME 下的缓存目录），
# 先注释掉这几行定位问题，再逐条加回来。
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/wedding
# 让子进程的 HOME 落在 /srv/wedding 内，配合上面的只读 home
Environment=HOME=/srv/wedding

# ── 资源上限 ─────────────────────────────────────────────────────
# 每次 query() 会拉起一个 claude 子进程，它和主进程在同一个 cgroup 里，
# 所以这里的上限是「两个进程加起来」。
#
# ⚠️ 别凭感觉写大数。目标机器实测只有 1.6G 总内存，上面还跑着别的服务
#    （nginx 两个站点、宝塔面板、firewalld、一堆阿里云 agent）。
#    上限设成 2G 会允许这个服务吃掉全机内存，然后 **OOM killer 按占用
#    挑人杀，被杀的不一定是我们** —— 可能顺手把宝塔或 nginx 干掉。
#    1G 的意义是：超额时死的是我们自己（systemd Restart=always 会拉回来，
#    对账逻辑会把卡片改成「服务重启了」），而不是邻居。
MemoryMax=1G
# 软限制：先触发回收和换页，到 1G 才真杀。给突发留一点缓冲。
MemoryHigh=800M

[Install]
WantedBy=multi-user.target
