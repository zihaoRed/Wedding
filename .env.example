# ── 飞书自建应用（open.feishu.cn/app → 凭证与基础信息）────────────────
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ── 模型凭据 ─────────────────────────────────────────────────────────
# SDK 不会自己读 .env，由 bot/index.mjs 用 dotenv 加载后显式传入。
#
# 两种形态，二选一：
#   · 官方 Anthropic  → 填 ANTHROPIC_API_KEY（sk-ant-...），BASE_URL 留空
#   · 中转 / 代理     → 填 ANTHROPIC_AUTH_TOKEN，并填 ANTHROPIC_BASE_URL
#
# ⚠️ dotenv 不覆盖已有的环境变量。如果你本机 shell 里已经设了
#    ANTHROPIC_AUTH_TOKEN，它会**盖过**这里的值。跑 npm run check 时会
#    把实际生效的地址打出来，对不上就是这个问题。
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=

# 境内 VPS 通常直连 api.anthropic.com 不通而飞书正常，
# 表现为「机器人活着但永远分析失败」。这种情况必须填中转地址，境外留空。
# 例：https://api.deepseek.com/anthropic
ANTHROPIC_BASE_URL=

# ⚠️ 中转不认 claude-* 型号名。用中转就必须改成中转支持的模型名，
#    否则会报 model not found。留空则退回 ANTHROPIC_MODEL 环境变量。
MODEL=

# 高级项：系统根证书包路径。一般不用填——代码会按平台自动探测
# （macOS /etc/ssl/cert.pem、Debian /etc/ssl/certs/ca-certificates.crt）。
# 只有在自动探测失败、或你的中转走自签证书代理时才需要显式指定。
# 这个值同样会传给 SDK 子进程，用来解决它内置信任库认不出中间 CA 的问题。
NODE_EXTRA_CA_CERTS=

# ── 访问控制 ─────────────────────────────────────────────────────────
# 留空 = 不限制。建议填上，避免机器人被拉进群后群消息也触发分析。
ALLOWED_USERS=
ALLOWED_CHATS=

# ── 运行参数 ─────────────────────────────────────────────────────────
# 单条任务的墙钟超时，超过就 interrupt 并推进队列（毫秒）
JOB_TIMEOUT_MS=240000
# 单次分析的美元上限（注意：这是「单次」，不是每月总额）
MAX_BUDGET_USD=1.5
MAX_TURNS=40
# 上下文里带上最近几轮对话（不用 resume，靠这个维持短期连贯）
RECENT_TURNS=6
# 连发图片的合并窗口（毫秒）。一次转发多张在飞书里是多条独立消息，
# 窗口内到达的同会话消息会并成一个任务、一次 Agent 回合。
# 实测 6 张不合并要 $1.76，合并后约 $0.3。代价：单发一张图会晚这么多才回。
COALESCE_MS=8000

# ── 静态托管（deploy/nginx.conf）────────────────────────────────────
# 用于对比页的「打开」按钮，必须是对外可访问的地址
PUBLIC_BASE_URL=

# ── 运维 ─────────────────────────────────────────────────────────────
# 心跳文件，外部 cron 检查它是否新鲜，用来发现长连接静默失联。
# 留空即可：默认落在 <项目目录>/state/heartbeat（VPS 上就是 /srv/wedding/state/heartbeat）。
# ⚠️ 不要在这里写死绝对路径。本地跑的时候会指到 VPS 路径上，启动即崩。
# HEARTBEAT_FILE=
# raw/ 截图保留天数
RAW_RETENTION_DAYS=90
